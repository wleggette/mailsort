{
  "permissions": {
    "ask": [
      "Edit(~/Workspace/kaylix/**)",
      "Write(~/Workspace/kaylix/**)",
      "NotebookEdit(~/Workspace/kaylix/**)",
      "Edit(~/Workspace/tools/**)",
      "Write(~/Workspace/tools/**)",
      "NotebookEdit(~/Workspace/tools/**)"
    ],
    "additionalDirectories": [
      "~/Workspace/kaylix",
      "~/Workspace/tools"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-external-writes.py\""
          }
        ]
      }
    ]
  }
}
