{
  "permissions": {
    "ask": [
      "Edit(~/Workspace/tools/**)",
      "Write(~/Workspace/tools/**)",
      "NotebookEdit(~/Workspace/tools/**)",
      "Edit(~/Workspace/agents/**)",
      "Write(~/Workspace/agents/**)",
      "NotebookEdit(~/Workspace/agents/**)"
    ],
    "additionalDirectories": [
      "~/Workspace/kaylix",
      "~/Workspace/tools",
      "~/Workspace/agents"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-external-writes.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-external-writes.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '\"$HOME/.claude/bin/doc-review\" hook || true'"
          }
        ]
      }
    ]
  }
}
